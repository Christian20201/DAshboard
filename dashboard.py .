import streamlit as st
import pandas as pd
import numpy as np
import plotly.express as px
from wordcloud import WordCloud
import matplotlib.pyplot as plt

# Configuración del Dashboard
st.title("📊 Dashboard de Monitoreo de Medios en Tiempo Real")

# Simulación de datos de menciones por destino
destinos = ["Quintana Roo", "Cancún", "Riviera Nayarit", "Tulum", "Los Cabos"]
menciones = np.random.randint(500, 1500, size=len(destinos))

df = pd.DataFrame({"Destino": destinos, "Menciones": menciones})

# Gráfico de menciones
fig = px.bar(df, x="Destino", y="Menciones", title="Menciones por Destino")
st.plotly_chart(fig)

# Simulación de análisis de sentimiento
sentimiento = np.random.randint(10, 500, size=(30, 3))
fechas = pd.date_range(start="2024-02-01", periods=30, freq="D")

df_sentimiento = pd.DataFrame(sentimiento, columns=["Positivo", "Negativo", "Neutral"], index=fechas)

st.line_chart(df_sentimiento)

# Nube de palabras
texto_tendencias = "sostenible lujo gastronomía experiencias playa aventura ecoturismo familiar vida-nocturna resorts relajación"
wordcloud = WordCloud(width=400, height=200, background_color="white").generate(texto_tendencias)

fig, ax = plt.subplots(figsize=(6, 3))
ax.imshow(wordcloud, interpolation="bilinear")
ax.axis("off")

st.pyplot(fig)
